# ==============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================
# NOTE: Replace all placeholder values with actual production values

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
POSTGRES_DB=unifiedchat_prod
POSTGRES_USER=unifiedchat_prod
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_PORT=5432
DB_MAX_CONNECTIONS=200
DB_MAX_IDLE_CONNECTIONS=20

# ==============================================
# REDIS CONFIGURATION
# ==============================================
REDIS_PORT=6379
REDIS_DB=0

# ==============================================
# AUTHENTICATION & SECURITY
# ==============================================
JWT_SECRET=REPLACE_WITH_STRONG_JWT_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRY=1h

# ==============================================
# SERVICE PORTS
# ==============================================
USER_SERVICE_PORT=8081
AUTH_SERVICE_PORT=8082
MESSAGE_SERVICE_PORT=8083
REALTIME_SERVICE_PORT=8084
GATEWAY_SERVICE_PORT=8080
FRONTEND_PORT=3000

# ==============================================
# JANUS WEBRTC SERVER CONFIGURATION
# ==============================================
JANUS_ADMIN_PORT=8090
JANUS_HTTP_PORT=8088
JANUS_HTTPS_PORT=8089
JANUS_WS_PORT=8188
JANUS_RTP_PORT=8000
JANUS_RTP_RANGE=10000-10200
JANUS_LOG_LEVEL=2
JANUS_LOG_TIMESTAMPS=true
JANUS_STUN_SERVER=stun:stun.l.google.com:19302
JANUS_TURN_SERVER=turn:YOUR_DOMAIN:3478

# ==============================================
# TURN SERVER CONFIGURATION
# ==============================================
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_USERNAME=REPLACE_WITH_TURN_USERNAME
TURN_PASSWORD=REPLACE_WITH_STRONG_TURN_PASSWORD
TURN_REALM=YOUR_DOMAIN
TURN_EXTERNAL_IP=YOUR_SERVER_PUBLIC_IP

# ==============================================
# FRONTEND CONFIGURATION
# ==============================================
NEXT_PUBLIC_AUTH_API_URL=https://YOUR_DOMAIN/api/v1
NEXT_PUBLIC_MESSAGE_API_URL=https://YOUR_DOMAIN/api/v1
NEXT_PUBLIC_REALTIME_API_URL=wss://YOUR_DOMAIN/ws
NEXT_PUBLIC_REALTIME_HTTP_API_URL=https://YOUR_DOMAIN
NEXT_PUBLIC_JANUS_URL=wss://YOUR_DOMAIN:8188
NEXT_PUBLIC_JANUS_HTTP_URL=https://YOUR_DOMAIN:8088

# ==============================================
# APPLICATION CONFIGURATION
# ==============================================
NODE_ENV=production
LOG_LEVEL=warn

# ==============================================
# CORS & RATE LIMITING
# ==============================================
CORS_ALLOWED_ORIGINS=https://YOUR_DOMAIN,https://www.YOUR_DOMAIN
RATE_LIMIT_REQUESTS=50
RATE_LIMIT_WINDOW=60

# ==============================================
# WEBSOCKET CONFIGURATION
# ==============================================
WS_READ_BUFFER_SIZE=4096
WS_WRITE_BUFFER_SIZE=4096
