general: {
    enabled = true
    port = 8088
    interface = "0.0.0.0"
    ip = "0.0.0.0"
    threads = 4
    http = true
    https = false

    # Minimal settings for Render compatibility
    base_path = "/janus"

    # Serve static content for root path
    doc_root = "/usr/local/share/janus"

    # Enable index file serving for health checks
    index_files = ["index.html"]

    # Enable CORS for all origins
    cors: {
        enabled = true
        origin = "*"
        methods = "GET,POST,PUT,DELETE,OPTIONS,HEAD"
        headers = "Content-Type,Authorization,X-Requested-With"
    }

    # Disable WebSocket on HTTP transport to avoid conflicts
    ws = false
}

