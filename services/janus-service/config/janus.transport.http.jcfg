general: {
    enabled = true
    port = 8088
    interface = "0.0.0.0"
    ip = "0.0.0.0"
    threads = 4
    http = true
    https = false

    # Base path for Janus API
    base_path = "/janus"

    # Serve static content for root path health checks
    doc_root = "/usr/local/share/janus"

    # Enable index file serving for health checks
    index_files = ["index.html"]

    # Handle root path requests properly
    root_redirect = false

    # Enable CORS for all origins
    cors: {
        enabled = true
        origin = "*"
        methods = "GET,POST,PUT,DELETE,OPTIONS,HEAD"
        headers = "Content-Type,Authorization,X-Requested-With"
    }

    # Disable WebSocket on HTTP transport to avoid conflicts with dedicated WebSocket transport
    ws = false

    # Additional security and stability settings
    timeout = 60
    max_connections = 1000
}

