general: {
    enabled = true
    port = 8088
    interface = "0.0.0.0"
    ip = "0.0.0.0"
    threads = 4
    http = true
    https = false

            # Additional HTTP settings
    base_path = "/janus"

    # Serve static files for root path to prevent "Invalid url /" errors
    doc_root = "/usr/local/share/janus"

    # CORS settings for web frontend
    cors: {
        enabled = true
        origin = "*"
        methods = "GET,POST,PUT,DELETE,OPTIONS,HEAD"
        headers = "Content-Type,Authorization"
    }

    # WebSocket settings - enable WebSocket upgrades on HTTP port
    ws = true
    ws_port = 8088
    ws_interface = "0.0.0.0"
    ws_ip = "0.0.0.0"
}

