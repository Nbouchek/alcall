general: {
    enabled = true
    port = 10000
    interface = "0.0.0.0"
    ip = "0.0.0.0"
    threads = 4
    http = true
    https = false

    # Additional HTTP settings
    base_path = "/janus"

    # Health check endpoint for Render
    admin_base_path = "/admin"
    admin_port = 10000

    # CORS settings for web frontend
    cors: {
        enabled = true
        origin = "*"
        methods = "GET,POST,PUT,DELETE,OPTIONS,HEAD"
        headers = "Content-Type,Authorization"
    }

    # WebSocket settings
    ws = true
    ws_port = 10001
    ws_interface = "0.0.0.0"
    ws_ip = "0.0.0.0"

    # Enable info endpoint for health checks
    info = true
}

# Admin/Monitor API configuration for health checks
admin: {
    admin_enabled = true
    admin_port = 10000
    admin_interface = "0.0.0.0"
    admin_ip = "0.0.0.0"
    admin_base_path = "/admin"
}
