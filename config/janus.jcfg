general: {
    configs_folder = "/usr/local/etc/janus"
    plugins_folder = "/usr/local/lib/janus/plugins"
    loggers_folder = "/usr/local/lib/janus/loggers"
    transports_folder = "/usr/local/lib/janus/transports"
    log_to_file = false
    debug_level = 4
    debug_timestamps = true
    debug_colors = false

    # STUN servers for NAT traversal (required for internet deployment)
    stun_server = "stun.l.google.com"
    stun_port = 19302

    # Alternative STUN servers as backup
    # stun_server = "stun1.l.google.com"
    # stun_server = "stun2.l.google.com"

    ice_lite = false
    ice_tcp = false

    # Disable problematic plugins
    disabled_plugins = ["janus.plugin.voicemail", "janus.eventhandler.gelfevh"]

    # Ensure explicit path to prevent permission errors
    module_path = "/usr/local/lib/janus"

    # Attempt to fix logger access by specifying the path or disabling if necessary
    # logger_plugins_folder = "/usr/local/lib/janus/loggers"  // Commented out to resolve access issues
    # Ensure the path is explicitly set to resolve permission errors
    # If still issues, comment out to bypass
    # logger_plugins_folder = null
}

# NAT configuration for cloud deployment
nat: {
    # Use STUN for NAT detection
    stun_server = "stun.l.google.com"
    stun_port = 19302

    # TURN server configuration for relay when direct connection fails
    turn_server = "turn.openrelay.metered.ca:3478?transport=udp"
    turn_server = "turn.openrelay.metered.ca:3478?transport=tcp"
    turn_user = "openrelayproject"
    turn_pwd = "openrelayproject"

    # Enable TURN relay (optional, for better connectivity)
    nice_debug = false
    full_trickle = true
    ice_lite = false
    ice_tcp = false
}
