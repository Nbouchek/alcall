# Core Service Ports
AUTH_SERVICE_PORT=8082
GATEWAY_SERVICE_PORT=8080
MESSAGE_SERVICE_PORT=8083
REALTIME_SERVICE_PORT=8084
USER_SERVICE_PORT=8081
JANUS_SERVICE_PORT=8088
JANUS_ADMIN_PORT=8090
JANUS_HTTP_PORT=8088
JANUS_HTTPS_PORT=8089
JANUS_WS_PORT=8188

# Janus RTP Ports
JANUS_RTP_PORT=8000
JANUS_RTP_RANGE=10000-10200
JANUS_TURN_USERNAME=
JANUS_TURN_PASSWORD=

# Service Internal URLs (for Gateway to proxy to)
GATEWAY_SERVICE_AUTH_SERVICE_URL=http://unifiedchat-auth-service:8082
GATEWAY_SERVICE_USER_SERVICE_URL=http://unifiedchat-user-service:8081
GATEWAY_SERVICE_MESSAGE_SERVICE_URL=http://unifiedchat-message-service:8083
REALTIME_SERVICE_URL=http://unifiedchat-realtime-service:8084

# Database Configuration
POSTGRES_DB=unifiedchat
POSTGRES_USER=unifiedchat
POSTGRES_PASSWORD=password123
POSTGRES_PORT=5432
REDIS_PORT=6379

# JWT Secret for Auth Service
AUTH_SERVICE_JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Frontend Environment Variables (for Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8084
NEXT_PUBLIC_AUTH_API_URL=http://localhost:8080/api/v1/auth
NEXT_PUBLIC_MESSAGE_API_URL=http://localhost:8080/api/v1/messages
NEXT_PUBLIC_REALTIME_API_URL=ws://localhost:8084/ws
NEXT_PUBLIC_REALTIME_HTTP_API_URL=http://localhost:8084
NEXT_PUBLIC_JANUS_URL=ws://localhost:8188/ws
NEXT_PUBLIC_JANUS_HTTP_URL=http://localhost:8088

# Janus Logging
JANUS_SERVICE_LOG_LEVEL=4
JANUS_SERVICE_LOG_TIMESTAMPS=true

# Database DSN (for Go services)
MESSAGE_SERVICE_POSTGRES_DSN="host=postgres user=unifiedchat password=${POSTGRES_PASSWORD} dbname=unifiedchat port=5432 sslmode=disable"
REALTIME_SERVICE_POSTGRES_DSN="host=postgres user=unifiedchat password=${POSTGRES_PASSWORD} dbname=unifiedchat port=5432 sslmode=disable"
USER_SERVICE_POSTGRES_DSN="host=postgres user=unifiedchat password=${POSTGRES_PASSWORD} dbname=unifiedchat port=5432 sslmode=disable"
